DATABASE_URL="postgresql://USER@localhost:5432/recipe_book?schema=public"
BETTER_AUTH_SECRET="generate-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional — AI tag/veg suggestions + photo OCR (OpenAI-compatible)
# Set a monthly spend limit in the provider console to avoid surprise bills.
#
# OpenAI:
#   IMPORT_API_KEY=sk-...
#   IMPORT_API_BASE=https://api.openai.com/v1
#   IMPORT_MODEL=gpt-4o-mini
#   IMPORT_VISION_MODEL=gpt-4o-mini
#
# Mistral (Pixtral does photo/OCR):
#   IMPORT_API_KEY=...
#   IMPORT_API_BASE=https://api.mistral.ai/v1
#   IMPORT_MODEL=mistral-small-latest
#   IMPORT_VISION_MODEL=pixtral-12b-2409
#
# IMPORT_API_KEY=
# IMPORT_API_BASE=
# IMPORT_MODEL=
# IMPORT_VISION_MODEL=

# Optional — email recipe share
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_SECURE=false
